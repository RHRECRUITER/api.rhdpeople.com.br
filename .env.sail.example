APP_NAME=RHdPeople
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

############################################
# SANCTUM, CORS & SPA AUTHENTICATION
############################################
# Informar de onde o Frontend vai estar rodando.
# Ex: http://localhost:3000 (Dev) | https://app.rhdpeople.com.br (Prod)
FRONTEND_URL=
# Domínios e portas que a API deve reconhecer como uma "SPA confiável".
# Permite que o Sanctum envie os cookies de autenticação (Stateful).
SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=
# Escopo do domínio onde os cookies de sessão serão válidos.
# Em desenvolvimento use 'localhost'. Em produção use '.rhdpeople.com.br'
SESSION_DOMAIN=localhost

############################################
# BANCO PRINCIPAL (CORE)
############################################

DB_CONNECTION=conn_rhdpeople_geral
DB_HOST=rhdpeople_geral
DB_PORT=3306
DB_DATABASE=db_rhdpeople_geral
DB_USERNAME=rhdpeople_dbadmin
DB_PASSWORD=password
DB_URL=
DB_SOCKET=
MYSQL_EXTRA_OPTIONS=

############################################
# BANCO LANDING / TRACKING
############################################

DB_CONNECTION_LANDINGPAGE=conn_rhdpeople_landingpage
DB_HOST_LANDINGPAGE=rhdpeople_landingpage
DB_PORT_LANDINGPAGE=3306
DB_DATABASE_LANDINGPAGE=db_rhdpeople_landingpage
DB_USERNAME_LANDINGPAGE=rhdpeople_dbadmin
DB_PASSWORD_LANDINGPAGE=password
DB_URL_LANDINGPAGE=
DB_SOCKET_LANDINGPAGE=
MYSQL_EXTRA_OPTIONS_LANDINGPAGE=

############################################
# SESSION / CACHE / QUEUE
############################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

############################################
# REDIS
############################################

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

############################################
# MAIL (Mailpit via Sail)
############################################

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@rhdpeople.com"
MAIL_FROM_NAME="${APP_NAME}"

############################################
# AWS (Opcional)
############################################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

############################################
# VITE
############################################

VITE_APP_NAME="${APP_NAME}"
