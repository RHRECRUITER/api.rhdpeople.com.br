APP_NAME=RHdPeople
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

############################################
# BANCO PRINCIPAL (MYSQL LOCAL)
############################################

DB_CONNECTION=conn_rhdpeople_geral
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_rhdpeople_geral
DB_USERNAME=root
DB_PASSWORD=
DB_URL=
DB_SOCKET=
MYSQL_EXTRA_OPTIONS=

############################################
# BANCO LANDING / TRACKING
############################################

DB_CONNECTION_LANDINGPAGE=conn_rhdpeople_ladingpage
DB_HOST_LANDINGPAGE=127.0.0.1
DB_PORT_LANDINGPAGE=3306
DB_DATABASE_LANDINGPAGE=db_rhdpeople_ladingpage
DB_USERNAME_LANDINGPAGE=root
DB_PASSWORD_LANDINGPAGE=
DB_URL_LANDINGPAGE=
DB_SOCKET_LANDINGPAGE=
MYSQL_EXTRA_OPTIONS_LANDINGPAGE=

############################################
# SESSION / CACHE / QUEUE
############################################

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

############################################
# REDIS (OPCIONAL)
############################################

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

############################################
# MAIL (LOCAL)
############################################

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@rhdpeople.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"